---
import PhotoPlaceholder from './PhotoPlaceholder.astro';
import { resume } from '../data/resume';

const [education] = resume.education;
const currentJob = resume.experience.find(job => job.current);

const headline = [
  `${education.degree}, ${education.schoolShort}`,
  `${education.minor} minor`,
  `Graduating ${education.year}`,
  currentJob && `${currentJob.role}, ${currentJob.org}`,
].filter(Boolean);
---

<section class="profile">
  <PhotoPlaceholder name={resume.name} src={resume.photo} size={120} />
  <div class="profile-text">
    <h1>{resume.name}</h1>
    <p class="headline">
      <span class="headline-items">
        {headline.map(item => <span>{item}</span>)}
      </span>
    </p>
    <p class="tagline">{resume.tagline}</p>
    <div class="contact-row">
      <a href={`mailto:${resume.contact.email}`} class="contact-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
        Email
      </a>
      <a href={resume.contact.github} class="contact-link" target="_blank" rel="noopener noreferrer">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
        GitHub
      </a>
      <a href={resume.contact.linkedin} class="contact-link" target="_blank" rel="noopener noreferrer">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
        LinkedIn
      </a>
    </div>
  </div>
</section>

<style>
  .profile {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .profile-text h1 {
    margin: 0 0 0.4rem;
  }

  /* Each item's separator sits in a gutter to its left. The gutter of whichever
     item starts a line falls outside .headline and is clipped, so no line begins with "·". */
  .headline {
    overflow: hidden;
    margin-bottom: 0.6rem;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .headline-items {
    display: flex;
    flex-wrap: wrap;
    row-gap: 0.15rem;
    margin-left: -1.2rem;
  }

  .headline-items > span::before {
    content: '·';
    display: inline-block;
    width: 1.2rem;
    text-align: center;
    color: var(--secondary);
    font-weight: 700;
  }

  .tagline {
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .contact-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .contact-link:hover {
    color: var(--accent);
  }

  @media (max-width: 600px) {
    .profile {
      flex-direction: column;
      text-align: center;
    }

    .headline-items {
      flex-direction: column;
      align-items: center;
      margin-left: 0;
    }

    .headline-items > span::before {
      content: none;
    }

    .contact-row {
      justify-content: center;
    }
  }
</style>

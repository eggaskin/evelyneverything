---
import { resume } from '../data/resume';
---

<div class="niches">
  {resume.skillNiches.map(skill => (
    <span class="tag tag--accent">{skill}</span>
  ))}
</div>
<dl class="skill-groups">
  {resume.skills.map(group => (
    <div>
      <dt>{group.label}</dt>
      <dd>{group.items.join(', ')}</dd>
    </div>
  ))}
</dl>

<style>
  .niches {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .skill-groups {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  dt {
    display: inline;
    font-weight: 600;
  }

  dt::after {
    content: ': ';
  }

  dd {
    display: inline;
    color: var(--text-secondary);
  }
</style>

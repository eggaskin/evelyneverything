---
import { resume } from '../data/resume';

interface Props {
  /** Show only the skill niche tags, without the grouped skills list. */
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<div class:list={['niches', { 'niches--compact': compact }]}>
  {resume.skillNiches.map(skill => (
    <span class="tag tag--accent">{skill}</span>
  ))}
</div>
{!compact && (
  <dl class="skill-groups">
    {resume.skills.map(group => (
      <div>
        <dt>{group.label}</dt>
        <dd>{group.items.join(', ')}</dd>
      </div>
    ))}
  </dl>
)}

<style>
  .niches {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .niches--compact {
    margin-bottom: 0;
  }

  .skill-groups {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  dt {
    display: inline;
    font-weight: 600;
  }

  dt::after {
    content: ': ';
  }

  dd {
    display: inline;
    color: var(--text-secondary);
  }
</style>

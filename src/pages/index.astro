---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileHeader from '../components/ProfileHeader.astro';
import Skills from '../components/Skills.astro';
import { resume } from '../data/resume';
import { getPublished } from '../utils/collections';
import { url } from '../utils/url';
import siteConfig from '../../site.config';

const projects = await getPublished('projects');
---

<BaseLayout title={siteConfig.title} description={resume.tagline} variant="blog">
  <div class="container">
    <ProfileHeader compact />

    <section class="page-section">
      <h2>Skills</h2>
      <Skills compact />
    </section>

    {projects.length > 0 && (
      <div class="check-out">
        <p class="check-out-label">Check out:</p>
        <ul class="project-list">
          {projects.map(project => (
            <li><a href={url(`/projects/${project.id}`)}>{project.data.title}</a></li>
          ))}
        </ul>
      </div>
    )}

    <div class="home-links">
      <a href={url('/resume')} class="btn btn--primary">View full resume</a>
      <a href={url('/blog')} class="btn btn--secondary">Read the blog</a>
    </div>
  </div>
</BaseLayout>

<style>
  .check-out {
    margin-bottom: 2.5rem;
  }

  .check-out-label {
    margin-bottom: 0.25rem;
    font-weight: 600;
  }

  .project-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .project-list a {
    font-weight: 500;
  }

  .home-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileHeader from '../components/ProfileHeader.astro';
import Skills from '../components/Skills.astro';
import { resume } from '../data/resume';
import { getPublished } from '../utils/collections';
import { url } from '../utils/url';
import siteConfig from '../../site.config';

const projects = await getPublished('projects');
---

<BaseLayout title={siteConfig.name} description={resume.tagline} variant="blog">
  <div class="container">
    <ProfileHeader />

    <section class="page-section">
      <h2>Skills</h2>
      <Skills />
    </section>

    {projects.length > 0 && (
      <section class="page-section">
        <h2>Projects</h2>
        <ul class="project-list">
          {projects.map(project => (
            <li>
              <a href={url(`/projects/${project.id}`)}>{project.data.title}</a>
              <span class="project-description">{project.data.description}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="home-links">
      <a href={url('/resume')} class="btn btn--primary">View full resume</a>
      <a href={url('/blog')} class="btn btn--secondary">Read the blog</a>
    </div>
  </div>
</BaseLayout>

<style>
  .project-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .project-list a {
    font-weight: 500;
  }

  .project-description {
    display: block;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .home-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
</style>

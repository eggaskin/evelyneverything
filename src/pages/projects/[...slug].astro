---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackLink from '../../components/BackLink.astro';
import ProjectLinks from '../../components/ProjectLinks.astro';
import { url } from '../../utils/url';
import { formatDate } from '../../utils/date';
import { getPublished } from '../../utils/collections';

export async function getStaticPaths() {
  const projects = await getPublished('projects');
  return projects.map(project => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const dateStr = formatDate(project.data.pubDate);
---

<BaseLayout title={`${project.data.title} | Projects`} description={project.data.description} variant="blog">
  <article class="container">
    <BackLink path="/projects" label="All projects" />
    <header class="project-header">
      <div class="project-header-main">
        <time datetime={project.data.pubDate.toISOString()}>{dateStr}</time>
        <h1>{project.data.title}</h1>
        <p class="description">{project.data.description}</p>
        {project.data.tags && project.data.tags.length > 0 && (
          <div class="tags">
            {project.data.tags.map(tag => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )}
      </div>
      {project.data.links && project.data.links.length > 0 && (
        <details class="links-menu">
          <summary aria-label="Project links" title="Project links">
            <span class="links-menu-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"></rect><line x1="15" y1="3" x2="15" y2="21"></line></svg>
            </span>
          </summary>
          <div class="links-menu-panel">
            <ProjectLinks links={project.data.links} />
          </div>
        </details>
      )}
    </header>
    {project.data.image && (
      <div class="project-image">
        <img src={url(project.data.image)} alt={project.data.title} />
      </div>
    )}
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .project-header {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .project-header-main {
    flex: 1;
    min-width: 0;
  }

  time {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  h1 {
    margin: 0.75rem 0 0.5rem;
    font-size: 2rem;
  }

  .description {
    font-size: 1.1rem;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  /* Project links stay hidden behind a toggle; opening it slides the panel out to the left. */
  .links-menu {
    position: relative;
    flex-shrink: 0;
  }

  /* Keep <summary> at its default display so it keeps native disclosure semantics;
     the visual box lives on the inner span. */
  .links-menu summary {
    list-style: none;
    cursor: pointer;
    border-radius: var(--radius);
  }

  .links-menu summary::-webkit-details-marker {
    display: none;
  }

  .links-menu summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .links-menu-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text-secondary);
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .links-menu summary:hover .links-menu-icon,
  .links-menu[open] .links-menu-icon {
    color: var(--accent);
    border-color: var(--accent);
  }

  .links-menu-panel {
    position: absolute;
    top: 0;
    right: calc(100% + 0.5rem);
    z-index: 5;
    width: max-content;
    max-width: calc(100vw - 6rem);
    padding: 0.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    animation: flow-out 0.18s ease-out;
    transform-origin: right center;
  }

  @keyframes flow-out {
    from {
      opacity: 0;
      transform: translateX(0.75rem) scaleX(0.9);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .links-menu-panel {
      animation: none;
    }
  }

  .project-image {
    margin-bottom: 2rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .project-image img {
    width: 100%;
    height: auto;
  }
</style>

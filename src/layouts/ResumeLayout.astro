---
import BaseLayout from './BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProfileHeader from '../components/ProfileHeader.astro';
import Skills from '../components/Skills.astro';
import { resume } from '../data/resume';
import { getPublished } from '../utils/collections';
import siteConfig from '../../site.config';

const projects = await getPublished('projects');
---

<BaseLayout title={siteConfig.resume.title} description={siteConfig.resume.tagline} variant="resume" wide>
  <div class="container container--wide">
    <ProfileHeader />

    <div class:list={['resume-body', { 'resume-body--with-projects': projects.length > 0 }]}>
      {projects.length > 0 && (
        <aside class="page-section resume-projects">
          <h2>Projects</h2>
          <div class="projects-stack">
            {projects.map(project => (
              <ProjectCard
                title={project.data.title}
                description={project.data.description}
                pubDate={project.data.pubDate}
                slug={project.id}
                tags={project.data.tags}
                links={project.data.links}
                image={project.data.image}
                compact
              />
            ))}
          </div>
        </aside>
      )}

      <div>
        <section class="page-section">
          <h2>Skills</h2>
          <Skills />
        </section>

        <section class="page-section">
          <h2>Experience</h2>
          {resume.experience.map(job => (
            <div class="entry">
              <div class="entry-header">
                <strong>{job.role}</strong>
                <span class="dates">{job.dates}</span>
              </div>
              <span class="entry-sub">{[job.org, job.location].filter(Boolean).join(' · ')}</span>
              <ul class="highlights">
                {job.highlights.map(item => <li>{item}</li>)}
              </ul>
            </div>
          ))}
        </section>

        <section class="page-section">
          <h2>Education</h2>
          {resume.education.map(edu => (
            <div class="entry">
              <div class="entry-header">
                <strong>{edu.school}</strong>
                <span class="dates">{edu.dates}</span>
              </div>
              <span class="entry-sub">
                {edu.degree}{edu.minor && `, ${edu.minor} minor`} · Expected {edu.year} · {edu.location}
              </span>
              <ul class="highlights">
                {edu.highlights.map(item => <li>{item}</li>)}
              </ul>
            </div>
          ))}
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .resume-body--with-projects {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 2.5rem;
    align-items: start;
  }

  .projects-stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .entry {
    padding: 0.75rem 0;
  }

  .entry-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 1rem;
  }

  .entry-sub {
    display: block;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .dates {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .highlights {
    margin-top: 0.5rem;
    padding-left: 1.25rem;
    font-size: 0.95rem;
  }

  .highlights li + li {
    margin-top: 0.25rem;
  }

  /* Single column on narrow screens, with projects after the resume content */
  @media (max-width: 800px) {
    .resume-body--with-projects {
      grid-template-columns: minmax(0, 1fr);
    }

    .resume-projects {
      order: 1;
    }
  }
</style>
